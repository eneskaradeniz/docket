{
  "name": "docket",
  "private": true,
  "version": "0.0.0",
  "license": "Apache-2.0",
  "description": "Docket — work-order console",
  "author": {
    "name": "Enes Karadeniz",
    "email": "eneskrdnz28@gmail.com"
  },
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:boundaries": "node scripts/check-boundaries.mjs && node scripts/check-layers.mjs && node scripts/check-rule-coverage.mjs",
    "gen:provider-matrix": "tsx scripts/gen-provider-matrix.mjs",
    "test:ui": "npm run build && node e2e/ui.mjs",
    "test:ui:report": "npm run build && { node e2e/layout-audit.mjs; a=$?; DOCKET_REPORT_APPEND=1 node e2e/journeys.mjs; b=$?; node e2e/a11y-snapshot.mjs; c=$?; exit $(( (a + b + c) > 0 )); }",
    "test:journeys": "npm run build && node e2e/journeys.mjs",
    "test:layout": "npm run build && node e2e/layout-audit.mjs",
    "test:gallery": "npm run build && node e2e/gallery.mjs",
    "icons": "node scripts/icons.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test:e2e-lock": "node --test e2e/lock.test.mjs",
    "test:e2e-sizes": "node --test e2e/layout-rules.test.mjs",
    "seed:design": "tsx e2e/seed-design.ts",
    "design": "node e2e/design-run.mjs",
    "operator-run": "tsx e2e/operator-run.mjs",
    "operator-handoff": "tsx e2e/operator-handoff.mjs",
    "test:seed-design": "node --test e2e/seed-design.test.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.221",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.5",
    "electron": "43.5.0",
    "electron-builder": "26.15.3",
    "playwright-core": "^1.62.1",
    "png-to-ico": "3.0.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vite-plugin-electron": "^1.1.1",
    "vitest": "^4.1.11"
  },
  "build": {
    "appId": "dev.docket.app",
    "productName": "Docket",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/@anthropic-ai/claude-agent-sdk/**",
      "node_modules/@anthropic-ai/claude-agent-sdk-*/**"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": "build",
        "filter": [
          "icon.png",
          "icon.ico",
          "tray*.png",
          "tray.ico"
        ]
      }
    ],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "icon": "build/icons",
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Enes Karadeniz <eneskrdnz28@gmail.com>"
    }
  }
}
